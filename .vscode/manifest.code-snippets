{
    "Manifest": {
        "prefix": "manifest",
        "description": "Basic Scoop manifest",
        "body": [
            "{",
            "    \"version\": \"$1\",",
            "    \"description\": \"$2\",",
            "    \"homepage\": \"$3\",",
            "    \"license\": \"$4\",",
            "    \"url\": \"$5\",",
            "    \"hash\": \"$6\",",
            "    \"checkver\": \"$7\",",
            "    \"autoupdate\": {",
            "        \"url\": \"$8\"",
            "    }",
            "}"
        ]
    },
    "GitHub Manifest": {
        "prefix": "github",
        "description": "GitHub-based manifest",
        "body": [
            "{",
            "    \"version\": \"$1\",",
            "    \"description\": \"$2\",",
            "    \"homepage\": \"https://github.com/${3}/${4}\",",
            "    \"license\": \"$5\",",
            "    \"url\": \"https://github.com/$3/$4/releases/download/v\\$version/${6}.zip\",",
            "    \"hash\": \"$7\",",
            "    \"checkver\": \"github\",",
            "    \"autoupdate\": {",
            "        \"url\": \"https://github.com/$3/$4/releases/download/v\\$version/${6}.zip\"",
            "    }",
            "}"
        ]
    },
    "Shortcuts": {
        "prefix": "shortcuts",
        "body": [
            "\"shortcuts\": [",
            "    [\"$1\", \"$2\"]",
            "],$0"
        ]
    },
    "Extract": {
        "prefix": "extract",
        "body": [
            "\"extract_dir\": \"$1\",$0"
        ]
    },
    "Persist": {
        "prefix": "persist",
        "body": [
            "\"persist\": [\"$1\"],$0"
        ]
    },
    "Dependencies": {
        "prefix": "depends",
        "body": [
            "\"depends\": [\"$1\"],$0"
        ]
    },
    "Pre Install": {
        "prefix": "preinstall",
        "body": [
            "\"pre_install\": \"$1\",$0"
        ]
    },
    "Post Install": {
        "prefix": "postinstall",
        "body": [
            "\"post_install\": \"$1\",$0"
        ]
    }
}
